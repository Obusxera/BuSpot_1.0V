{
  "manifest_version": 3,
  "name": "BuSpot_1.0V",
  "version": "1.0",
  "description": "BuSpot: tema UI modern, Dock ala macOS, dan Custom Wallpaper untuk SPOT UPI. By OBUSXERA.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://spot.upi.edu/*"
      ],
      "css": [
        "style.css",
        "crop.css",
        "dock.css"
      ],
      "js": [
        "icons.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
